# Copy to .env for LOCAL development only. Never commit .env.
# In production these are Fly secrets (fly secrets set ...).
DATABASE_URL=sqlite+pysqlite:///./local.db
APP_SECRET=change-me-local-only
PSEUDONYM_KEY=change-me-local-only
LOGIN_PASSWORD_HASH=
APP_ENV=local
APP_VERSION=0.1.0

# LLM (not needed for D1a-D3a). Switch models by changing these two.
LLM_PROVIDER=
LLM_MODEL=
# One key per provider you use; set only the ones you need.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
