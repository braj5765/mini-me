# Copy to .env for LOCAL development only. Never commit .env.
# In production these are Fly secrets (fly secrets set ...).
DATABASE_URL=sqlite+pysqlite:///./local.db
APP_SECRET=change-me-local-only
PSEUDONYM_KEY=change-me-local-only
# Encryption key for sender-tag labels (5.24). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Must be the SAME value on Render and in the laptop .env (export / delete / summary need it). Empty = APP_SECRET fallback.
DATA_ENCRYPTION_KEY=
# A sender tag unused this many days is deleted by /tasks/sweep (5.24).
SENDER_TAG_RETENTION_DAYS=30
LOGIN_PASSWORD_HASH=
APP_ENV=local
APP_VERSION=0.1.0

# LLM (D8a drafting). Switch models by changing these two.
LLM_PROVIDER=
LLM_MODEL=
# One key per provider you use; set only the ones you need.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=

# Telegram bot (D4a). Token and secret are Fly secrets in prod.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_PUBLIC_BASE_URL=https://mini-me.fly.dev
TELEGRAM_BLIND_RATIO=0.2
TELEGRAM_CAPTURE_WINDOW_HOURS=24

# Drafting (D8a). auto = real drafter when LLM_PROVIDER and LLM_MODEL are set, else the stub.
DRAFTER=auto
# v0.1 ONLY: declares incoming text as own / made-up so an unverified provider may be used.
# Never turn on for real third-party messages. Leave false once a provider is verified.
OWN_DATA_ONLY_MODE=false

# Edit classifier (D9a). Blank provider / model = same model as the drafter (LLM_PROVIDER / LLM_MODEL).
CLASSIFIER_PROVIDER=
CLASSIFIER_MODEL=
CLASSIFIER_MAX_TOKENS=1500
# true = send a one-line "Edit read as ..." note in the chat after each captured edit; false = stay quiet.
CLASSIFIER_NOTIFY=true
